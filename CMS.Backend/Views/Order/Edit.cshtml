@model CMS.Data.Entities.Order

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Sửa đơn hàng";
}

<div class="card shadow">
    <div class="card-header bg-warning">
        <h5 class="mb-0">SỬA ĐƠN HÀNG #@Model.Id</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CustomerId" class="form-label fw-bold">Khách hàng</label>
                    <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomerList">
                        <option value="">-- Chọn khách hàng --</option>
                    </select>
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="OrderDate" class="form-label fw-bold">Ngày đặt</label>
                    <input asp-for="OrderDate" class="form-control" type="datetime-local" />
                    <span asp-validation-for="OrderDate" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Status" class="form-label fw-bold">Trạng thái</label>
                    <select asp-for="Status" class="form-select">
                        <option value="0">Chờ duyệt</option>
                        <option value="1">Đang giao</option>
                        <option value="2">Đã xong</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="TotalAmount" class="form-label fw-bold">Tổng tiền</label>
                    <input asp-for="TotalAmount" class="form-control" type="number" min="0" step="1000" />
                    <span asp-validation-for="TotalAmount" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label fw-bold">Ghi chú</label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Cập nhật</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
