@model IEnumerable<CMS.Data.Entities.Order>

@{
    ViewData["Title"] = "Quản lý Đơn hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-uppercase mb-0 text-primary">Danh sách Đơn hàng</h3>
        <button class="btn btn-success">+ Tạo đơn hàng mới</button>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center shadow-sm">
            <strong>Chưa có đơn hàng nào được tạo!</strong>
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm">
            <table class="table table-bordered table-hover align-middle mb-0 bg-white">
                <thead class="table-light text-center">
                    <tr>
                        <th>Mã Đơn (ID)</th>
                        <th>Mã Khách Hàng</th>
                        <th>Ngày Đặt</th>
                        <th>Tổng Tiền</th>
                        <th>Trạng Thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold text-primary">#@item.Id</td>
                            <td class="text-center">@item.CustomerId</td>
                            <td class="text-center">@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-danger fw-bold text-end">@string.Format("{0:N0} đ", item.TotalAmount)</td>
                            <td class="text-center">
                                <span class="badge bg-info text-dark">@item.Status</span>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-outline-primary btn-sm">Xem chi tiết</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>