@model IEnumerable<CMS.Data.Entities.Order>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Đơn hàng";
}

@functions {
    string StatusText(int status) => status switch
    {
        0 => "Chờ duyệt",
        1 => "Đang giao",
        2 => "Đã xong",
        _ => "Không rõ"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="text-uppercase mb-1 text-primary">Danh sách đơn hàng</h3>
        <p class="text-muted mb-0">Theo dõi đơn hàng, trạng thái và tổng tiền.</p>
    </div>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Tạo đơn hàng
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-warning text-center shadow-sm">
        <strong>Chưa có đơn hàng nào được tạo!</strong>
    </div>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-bordered table-hover align-middle mb-0 bg-white">
            <thead class="table-light text-center">
                <tr>
                    <th>Mã Đơn</th>
                    <th>Khách hàng</th>
                    <th>Ngày Đặt</th>
                    <th>Số dòng hàng</th>
                    <th>Tổng Tiền</th>
                    <th>Trạng Thái</th>
                    <th style="width:230px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center fw-bold text-primary">#@item.Id</td>
                        <td>@(item.Customer?.FullName ?? $"Khách hàng #{item.CustomerId}")</td>
                        <td class="text-center">@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-center">@(item.OrderDetails?.Count ?? 0)</td>
                        <td class="text-danger fw-bold text-end">@string.Format("{0:N0} đ", item.TotalAmount)</td>
                        <td class="text-center">
                            <span class="badge bg-info text-dark">@StatusText(item.Status)</span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-outline-danger btn-sm"
                               onclick="return confirm('Bạn có chắc muốn xóa đơn hàng này?')">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
