@model CMS.Data.Entities.Order

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chi tiết đơn hàng";
}

@functions {
    string StatusText(int status) => status switch
    {
        0 => "Chờ duyệt",
        1 => "Đang giao",
        2 => "Đã xong",
        _ => "Không rõ"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="text-primary mb-1">Đơn hàng #@Model.Id</h3>
        <p class="text-muted mb-0">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <div>
        <a asp-controller="OrderDetail" asp-action="Create" asp-route-orderId="@Model.Id" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm sản phẩm
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa đơn</a>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-bold">Thông tin khách hàng</div>
            <div class="card-body">
                <p class="mb-1"><strong>Họ tên:</strong> @(Model.Customer?.FullName ?? "Không rõ")</p>
                <p class="mb-1"><strong>Email:</strong> @Model.Customer?.Email</p>
                <p class="mb-1"><strong>Điện thoại:</strong> @Model.Customer?.Phone</p>
                <p class="mb-0"><strong>Địa chỉ:</strong> @Model.Customer?.Address</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-bold">Thông tin đơn hàng</div>
            <div class="card-body">
                <p class="mb-1"><strong>Trạng thái:</strong> <span class="badge bg-info text-dark">@StatusText(Model.Status)</span></p>
                <p class="mb-1"><strong>Tổng tiền:</strong> <span class="text-danger fw-bold">@string.Format("{0:N0} đ", Model.TotalAmount)</span></p>
                <p class="mb-0"><strong>Ghi chú:</strong> @(string.IsNullOrWhiteSpace(Model.Notes) ? "Không có" : Model.Notes)</p>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive shadow-sm">
    <table class="table table-bordered table-hover align-middle bg-white mb-0">
        <thead class="table-light text-center">
            <tr>
                <th>Sản phẩm</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
                <th style="width:160px">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.OrderDetails == null || !Model.OrderDetails.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">Đơn hàng chưa có sản phẩm.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.OrderDetails)
                {
                    <tr>
                        <td class="fw-bold">@item.Product?.Name</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">@string.Format("{0:N0} đ", item.UnitPrice)</td>
                        <td class="text-end text-danger fw-bold">@string.Format("{0:N0} đ", item.Quantity * item.UnitPrice)</td>
                        <td class="text-center">
                            <a asp-controller="OrderDetail" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">Sửa</a>
                            <a asp-controller="OrderDetail" asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-outline-danger btn-sm"
                               onclick="return confirm('Bạn có chắc muốn xóa dòng sản phẩm này?')">Xóa</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
