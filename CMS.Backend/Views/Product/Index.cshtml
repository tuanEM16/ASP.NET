@model IEnumerable<CMS.Data.Entities.Product>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Sản phẩm";
    var categoryNames = ViewBag.CategoryProductNames as Dictionary<int, string> ?? new Dictionary<int, string>();
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;

    string GetDescriptionSummary(string? html)
    {
        var text = System.Text.RegularExpressions.Regex.Replace(
            html ?? string.Empty,
            @"<[^>]+>",
            " ");
        text = System.Net.WebUtility.HtmlDecode(text);
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();
        return text.Length > 70 ? text.Substring(0, 70) + "..." : text;
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="text-uppercase mb-1 text-primary">Danh sách sản phẩm</h3>
        <p class="text-muted mb-0">Quản lý sản phẩm, giá bán, tồn kho và danh mục.</p>
    </div>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Thêm sản phẩm
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-warning text-center shadow-sm">
        <strong>Hiện tại chưa có sản phẩm nào!</strong>
    </div>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-bordered table-hover align-middle mb-0 bg-white">
            <thead class="table-light text-center">
                <tr>
                    <th>ID</th>
                    <th>Hình ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Giá</th>
                    <th>Tồn kho</th>
                    <th style="width:210px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center fw-bold">@item.Id</td>
                        <td class="text-center">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Name" style="width: 80px; height: 80px; object-fit: cover;" class="rounded border" />
                            }
                            else
                            {
                                <span class="text-muted small">Chưa có ảnh</span>
                            }
                        </td>
                        <td>
                            <div class="fw-bold text-primary">@item.Name</div>
                            <div class="text-muted small">
                                @GetDescriptionSummary(item.Description)
                            </div>
                        </td>
                        <td class="text-center">@(categoryNames.ContainsKey(item.CategoryProductId) ? categoryNames[item.CategoryProductId] : "Chưa phân loại")</td>
                        <td class="text-danger fw-bold text-end">@string.Format("{0:N0} đ", item.Price)</td>
                        <td class="text-center">@item.StockQuantity</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Xem</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-outline-danger btn-sm"
                               onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?')">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (totalPages > 1)
    {
        <nav class="mt-3" aria-label="Phân trang sản phẩm">
            <ul class="pagination justify-content-center">
                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
