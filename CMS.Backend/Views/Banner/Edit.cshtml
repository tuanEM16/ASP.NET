@model CMS.Data.Entities.Banner

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Sửa banner";
    ViewData["SubmitText"] = "Cập nhật banner";
    ViewData["SubmitClass"] = "btn-primary";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="text-primary mb-1">Sửa banner</h3>
        <p class="text-muted mb-0">Cập nhật nội dung, liên kết và trạng thái hiển thị.</p>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input asp-for="Id" type="hidden" />
            <partial name="_Form" model="Model" view-data="ViewData" />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
