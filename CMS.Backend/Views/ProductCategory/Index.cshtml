@model IEnumerable<CMS.Data.Entities.CategoryProduct>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Danh mục sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="text-uppercase text-primary mb-1">Danh mục sản phẩm</h3>
        <p class="text-muted mb-0">Quản lý nhóm sản phẩm như váy, áo, phụ kiện...</p>
    </div>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Thêm danh mục
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-warning text-center shadow-sm">Chưa có danh mục sản phẩm nào.</div>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-bordered table-hover align-middle mb-0 bg-white">
            <thead class="table-light text-center">
                <tr>
                    <th style="width:80px">ID</th>
                    <th>Tên danh mục</th>
                    <th>Mô tả</th>
                    <th style="width:140px">Số sản phẩm</th>
                    <th style="width:180px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center fw-bold">@item.Id</td>
                        <td class="fw-bold text-primary">@item.Name</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Description) ? "Chưa có mô tả" : item.Description)</td>
                        <td class="text-center">@(item.Products?.Count ?? 0)</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-outline-danger btn-sm"
                               onclick="return confirm('Bạn có chắc muốn xóa danh mục này?')">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
