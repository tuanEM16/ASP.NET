@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Danh sách bài viết";
}

<div class="container mt-4">
    <h3 class="text-danger text-uppercase mb-4">Danh sách bài viết mới nhất</h3>

    <div class="row">
        @foreach (var post in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm border-light">
                    <img src="@post.ImageUrl" class="card-img-top" alt="Thumbnail" style="max-height: 200px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-primary fw-bold">@post.Title</h5>

                        <p class="card-text text-muted mb-4">
                            @(post.Content.Length > 80 ? post.Content.Substring(0, 80) + "..." : post.Content)
                        </p>

                        <div class="mt-auto">
                            <p class="card-text mb-2">
                                <small class="text-muted">Ngày đăng: @post.CreatedDate.ToString("dd/MM/yyyy")</small>
                            </p>
                            <a href="/Post/Details/@post.Id" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>