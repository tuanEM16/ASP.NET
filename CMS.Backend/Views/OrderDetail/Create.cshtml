@model CMS.Data.Entities.OrderDetail

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm chi tiết đơn hàng";
}

<div class="card shadow">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">THÊM SẢN PHẨM VÀO ĐƠN HÀNG</h5>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="OrderId" class="form-label fw-bold">Đơn hàng</label>
                    <select asp-for="OrderId" class="form-select" asp-items="ViewBag.OrderList">
                        <option value="">-- Chọn đơn hàng --</option>
                    </select>
                    <span asp-validation-for="OrderId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ProductId" class="form-label fw-bold">Sản phẩm</label>
                    <select asp-for="ProductId" class="form-select" asp-items="ViewBag.ProductList">
                        <option value="">-- Chọn sản phẩm --</option>
                    </select>
                    <span asp-validation-for="ProductId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Quantity" class="form-label fw-bold">Số lượng</label>
                    <input asp-for="Quantity" class="form-control" type="number" min="1" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="UnitPrice" class="form-label fw-bold">Đơn giá lúc mua</label>
                    <input asp-for="UnitPrice" class="form-control" type="number" min="0" step="1000" />
                    <span asp-validation-for="UnitPrice" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-success">Lưu chi tiết</button>
            <a asp-controller="Order" asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
