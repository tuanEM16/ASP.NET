@model IEnumerable<CMS.Data.Entities.OrderDetail>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chi tiết các Đơn hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="text-uppercase mb-1 text-success">Chi tiết đơn hàng</h3>
        <p class="text-muted mb-0">Danh sách tất cả sản phẩm đã được thêm vào đơn hàng.</p>
    </div>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Thêm chi tiết
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-warning text-center shadow-sm">
        <strong>Chưa có chi tiết đơn hàng nào!</strong>
    </div>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-bordered table-hover align-middle mb-0 bg-white">
            <thead class="table-light text-center">
                <tr>
                    <th>Mã Đơn</th>
                    <th>Khách hàng</th>
                    <th>Sản phẩm</th>
                    <th>Số lượng</th>
                    <th>Đơn giá lúc mua</th>
                    <th>Thành tiền</th>
                    <th style="width:180px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center fw-bold text-primary">#@item.OrderId</td>
                        <td>@item.Order?.Customer?.FullName</td>
                        <td class="fw-bold">@item.Product?.Name</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end text-danger">@string.Format("{0:N0} đ", item.UnitPrice)</td>
                        <td class="text-end fw-bold">@string.Format("{0:N0} đ", item.Quantity * item.UnitPrice)</td>
                        <td class="text-center">
                            <a asp-controller="Order" asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-outline-primary btn-sm">Đơn</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-outline-danger btn-sm"
                               onclick="return confirm('Bạn có chắc muốn xóa chi tiết này?')">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
